# Optional settings; fresh-install instructions also record the validated Tika image here.
# Set the real digest reported by docker image inspect; do not copy a placeholder.
# TIKA_IMAGE=ephemerai-tika:4.0.0-local@sha256:<validated-local-image-digest>
OLLAMA_MAX_QUEUE=16
# Optional API override only; keep loopback binding.
OLLAMA_API_BIND=127.0.0.1

# New isolated FP4 / Ollama-recovery profiles (scripts/deployment.py only).
# Keep the departmental host/origin settings in .streamlit/config.toml.
# For existing Windows-to-WSL forwarding, deliberately bind the WSL UI on all
# interfaces and retain the existing upstream network access control.
EPHEMERAI_BIND_ADDRESS=0.0.0.0
EPHEMERAI_PORT=8501
# Generated image identities belong to .local/images.env, not this file.
