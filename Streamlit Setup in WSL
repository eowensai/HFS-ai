#!/bin/bash
# Fix Docker DNS resolution in modern WSL2

# Configure Docker daemon to use a predictable bridge IP and DNS
cat > /etc/docker/daemon.json <<EOF
{
  "bip": "172.17.0.1/16",
  "dns": ["172.17.0.1"]
}
EOF

# Restart Docker to apply the new daemon config and create the docker0 bridge
systemctl restart docker

# Find WSL's DNS server, with a fallback to Google's DNS if not found
WSL_DNS=$(grep -m 1 '^nameserver' /etc/resolv.conf | awk '{print $2}')
if [ -z "$WSL_DNS" ]; then
    echo "Warning: Could not find WSL DNS server. Falling back to 8.8.8.8"
    WSL_DNS="8.8.8.8"
fi

# Apply iptables rules to forward DNS from the Docker bridge to the real DNS server
iptables -t nat -A PREROUTING -p udp --dport 53 -j DNAT --to-destination $WSL_DNS
iptables -t nat -A PREROUTING -p tcp --dport 53 -j DNAT --to-destination $WSL_DNS
