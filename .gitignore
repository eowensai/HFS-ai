# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Streamlit local artifacts
.streamlit/secrets.toml

# Local environment and secrets
.env
.env.*
*.local

# Editor and IDE settings
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Generated test artifacts
artifacts/

# Host-built service core-dump policy (source in deployment/privacy).
deployment/privacy/*.so

# Large recovery assets stay outside Git.
downloads/
*.tar
*.tar.gz
*.zip

# Machine-specific Compose overrides and deployment records
.local/

# FP4 downloads/builds stay local; no weights or native objects in Git.
*.safetensors
*.gguf
*.whl
*.bundle
*.tar
ephemeral/assets/qwen-tokenizer.json
deployment/fp4/native/*.o

# Private local evidence, immutable recovery software and native helper products.
evidence/
research/
*.nsys-rep
*.sqlite
*.pt
*.safetensors
*.gguf
*.o
*.cubin
