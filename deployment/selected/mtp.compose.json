{
  "name": "hfsai-mtp-recovery",
  "networks": {
    "llm-net": {
      "name": "ephemeral-llm_llm-net",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "ephemeral-app": {
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "container_name": "hfsai-app-mtp-recovery",
      "depends_on": {
        "vllm": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "LD_PRELOAD": "/opt/ephemerai/libephemerai_nodump.so",
        "LLM_BACKEND": "vllm",
        "LLM_BASE_URL": "http://hfsai-vllm-mtp-recovery:8000/v1",
        "LLM_CONTEXT_TOKENS": "131072",
        "LLM_DEPLOYMENT_MANIFEST": "/opt/ephemerai/deployment.json",
        "LLM_MAX_RETRIES": "0",
        "LLM_MAX_TOKENS": "32768",
        "LLM_MODEL_NAME": "ephemerai-qwen3.8-27b-nvfp4-131072",
        "LLM_OUTPUT_RESERVE_TOKENS": "32768",
        "LLM_PRESENCE_PENALTY": "0.0",
        "LLM_REASONING_EFFORT": "medium",
        "LLM_REQUEST_TIMEOUT_S": "1800",
        "LLM_SHOW_REASONING": "false",
        "LLM_TEMPERATURE": "1.0",
        "LLM_THINKING_EFFORT": "xhigh",
        "LLM_TOP_P": "0.95",
        "STREAMLIT_SERVER_ADDRESS": "0.0.0.0",
        "STREAMLIT_SERVER_HEADLESS": "true",
        "TIKA_URL": "http://tika-server:9998"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python3",
          "-c",
          "import urllib.request; urllib.request.urlopen(\"http://127.0.0.1:8501/_stcore/health\", timeout=5)"
        ],
        "timeout": "10s",
        "interval": "30s",
        "retries": 3,
        "start_period": "30s"
      },
      "image": "sha256:7209450b54fc5144399cf8dbb7aa9999d94ae94505afdee282a8b773b22dc184",
      "init": true,
      "labels": {
        "ephemerai.deployment": "hfsai-mtp-recovery"
      },
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "2m"
        }
      },
      "mem_limit": "2147483648",
      "memswap_limit": "2147483648",
      "networks": {
        "llm-net": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "0.0.0.0",
          "target": 8501,
          "published": "8501",
          "protocol": "tcp"
        }
      ],
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "runtime": "runc",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=1g,mode=1777",
        "/var/tmp:rw,nosuid,nodev,noexec,size=256m,mode=1777"
      ],
      "ulimits": {
        "core": 0
      },
      "volumes": [
        {
          "type": "bind",
          "source": "./mtp-deployment.json",
          "target": "/opt/ephemerai/deployment.json",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "./streamlit.toml",
          "target": "/app/.streamlit/config.toml",
          "read_only": true,
          "bind": {}
        }
      ]
    },
    "vllm": {
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "container_name": "hfsai-vllm-mtp-recovery",
      "deploy": {
        "resources": {
          "reservations": {
            "devices": [
              {
                "capabilities": [
                  "gpu"
                ],
                "driver": "nvidia",
                "count": -1
              }
            ]
          }
        },
        "placement": {}
      },
      "entrypoint": null,
      "environment": {
        "CUDA_CACHE_PATH": "/root/.cache/cuda-driver",
        "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
        "EPHEMERAI_ENGINE_STALL_SECONDS": "600",
        "EPHEMERAI_NATIVE_PREFILL": "1",
        "MAX_JOBS": "2",
        "NCCL_P2P_DISABLE": "1",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "TMPDIR": "/tmp",
        "TORCHINDUCTOR_CACHE_DIR": "/root/.cache/torchinductor/vllm",
        "TORCHINDUCTOR_COMPILE_THREADS": "2",
        "TRITON_CACHE_DIR": "/root/.cache/triton/vllm",
        "VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE": "67108864",
        "VLLM_PP_LAYER_PARTITION": "34,30",
        "VLLM_USE_V2_MODEL_RUNNER": "1",
        "VLLM_WSL2_ENABLE_PIN_MEMORY": "1",
        "XDG_CONFIG_HOME": "/tmp/config"
      },
      "expose": [
        "8000"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python3",
          "/opt/ephemerai/healthcheck.py"
        ],
        "timeout": "15s",
        "interval": "20s",
        "retries": 3,
        "start_period": "8m0s"
      },
      "image": "sha256:8601ca3e55990b33594cc3254f5f16248140acd278fe5e24ba122756d82a04e0",
      "init": true,
      "labels": {
        "ephemerai.deployment": "hfsai-mtp-recovery"
      },
      "logging": {
        "driver": "none"
      },
      "mem_limit": "27917287424",
      "memswap_limit": "27917287424",
      "networks": {
        "llm-net": null
      },
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "shm_size": "4294967296",
      "stop_grace_period": "40s",
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,size=4g,mode=1777",
        "/var/tmp:rw,nosuid,nodev,noexec,size=256m,mode=1777"
      ],
      "ulimits": {
        "core": 0
      },
      "volumes": [
        {
          "type": "volume",
          "source": "fp4-models",
          "target": "/models/radixark",
          "read_only": true,
          "volume": {
            "subpath": "radixark"
          }
        },
        {
          "type": "volume",
          "source": "qualified-kernel-cache",
          "target": "/root/.cache",
          "volume": {}
        }
      ],
      "working_dir": "/tmp"
    }
  },
  "volumes": {
    "fp4-models": {
      "name": "ephemeral-llm_fp4-models",
      "external": true
    },
    "qualified-kernel-cache": {
      "name": "hfsai-mtp-recovery-compiler-cache",
      "external": true
    }
  }
}
