<?xml version="1.0" encoding="UTF-8"?>
<properties>
  <parsers>
    <parser class="org.apache.tika.parser.DefaultParser">
      <parser-exclude class="org.apache.tika.parser.microsoft.ooxml.OOXMLParser"/>
    </parser>
    <parser class="org.apache.tika.parser.microsoft.ooxml.OOXMLParser">
      <params>
        <!-- Preserve existing comment attribution and note/slide ordering. -->
        <param name="useSAXDocxExtractor" type="bool">false</param>
        <param name="useSAXPptxExtractor" type="bool">false</param>
      </params>
    </parser>
  </parsers>
</properties>
